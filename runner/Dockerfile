# One runner image: the PHP Studio includes, and every MFTF build Studio
# offers. A run names the build it was generated by; what is Studio's own
# arrives in the run's bundle, so this image changes only with PHP or a build.
# Fetched and unpacked in a stage of its own, so no archive stays in the image.
FROM debian:bookworm-slim AS fetched
ARG PHP_RELEASE=php-8.4.27-3
ARG PHP_SHA256=b0bbc3b06613dbad9c5e329289e7187386bed7e5235dd7c6d471dd7bf0326c63
ADD https://github.com/rnscommerce/mftf-studio-php-runtime/releases/download/${PHP_RELEASE}/${PHP_RELEASE}-linux-x86_64.tar.gz /tmp/php.tgz
RUN echo "${PHP_SHA256}  /tmp/php.tgz" | sha256sum -c - \
 && mkdir -p /opt/php && tar xzf /tmp/php.tgz -C /opt/php && rm /opt/php/xdebug.so
# Each line is a release of rnscommerce/mftf-distros, which holds a classic
# build and a BiDi one.
ADD https://github.com/rnscommerce/mftf-distros/releases/download/mftf-4.7.6-7/4.7.6.tgz \
    https://github.com/rnscommerce/mftf-distros/releases/download/mftf-4.7.6-7/4.7.6-bidi.tgz \
    https://github.com/rnscommerce/mftf-distros/releases/download/mftf-5.3.0-7/5.3.0.tgz \
    https://github.com/rnscommerce/mftf-distros/releases/download/mftf-5.3.0-7/5.3.0-bidi.tgz \
    https://github.com/rnscommerce/mftf-distros/releases/download/mftf-6.0.1-7/6.0.1.tgz \
    https://github.com/rnscommerce/mftf-distros/releases/download/mftf-6.0.1-7/6.0.1-bidi.tgz \
    /tmp/mftf/
RUN mkdir -p /opt/mftf \
 && for archive in /tmp/mftf/*.tgz; do tar xzf "$archive" -C /opt/mftf; done

FROM composer:2 AS deps
WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --ignore-platform-reqs

FROM debian:bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates libstdc++6 tini \
 && rm -rf /var/lib/apt/lists/*
COPY --from=fetched /opt/php /opt/php
COPY php.ini /opt/php/php.ini
ENV PHPRC=/opt/php PATH=/opt/php:$PATH XDEBUG_MODE=off
COPY --from=fetched /opt/mftf /opt/mftf
COPY workspace /opt/workspace
COPY workspace-bidi /opt/workspace-bidi
COPY --from=deps /app/vendor /opt/runner/vendor
COPY runner.php /opt/runner/
EXPOSE 8080
# A stop reaches the runner through an init, which also takes in what a run leaves behind.
ENTRYPOINT ["tini", "--", "php", "/opt/runner/runner.php"]
